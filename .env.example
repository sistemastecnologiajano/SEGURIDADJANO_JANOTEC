# Copia este archivo como ".env" (sin ".example") en la raíz del proyecto,
# en el servidor, y rellena los valores reales. El .env NUNCA se sube a
# ningún repositorio ni se comparte - se crea directo en el servidor.

# Clave secreta de Django - genera una distinta a esta para el servidor real.
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Déjalo en False en el servidor real (producción).
DEBUG=False

# Dominios permitidos, separados por coma.
ALLOWED_HOSTS=gestiontic.seguridadjano.com

# Base de datos: usa "mysql" en el servidor real (MariaDB de Plesk).
DB_ENGINE=mysql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Correo para las alertas diarias - mismo servidor que JANOTEC, otra cuenta.
EMAIL_HOST=mail.seguridadjano.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Destinatarios de las alertas, separados por coma.
ALERTAS_DESTINATARIOS=

# Días de antelación para avisar subactividades por vencer (0 = solo el día de la fecha de compromiso).
DIAS_ANTES_VENCIMIENTO=0
